<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. 드래그 가능한 조준경 타겟 (지름 80dp 크기) -->
    <ImageView
        android:id="@+id/imgCrosshairTarget"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/bg_target_crosshair"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true" />

    <!-- 2. 플로팅 컨트롤 패널 (상단 중앙) -->
    <LinearLayout
        android:id="@+id/panelControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_floating_popup"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:gravity="center"
        android:elevation="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 조준경을 손으로 드래그 후 1px 화살표로 미세조정하세요"
            android:textColor="#3DDC84"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 조준 위치: X = 1130, Y = 70"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- [정밀 1px 미세조정 화살표 버튼] -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/btnNudgeLeft1"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_dock_btn"
                android:text="◀ 1px"
                android:textColor="#3DDC84"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNudgeUp1"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_dock_btn"
                android:text="▲ 1px"
                android:textColor="#3DDC84"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNudgeDown1"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_dock_btn"
                android:text="▼ 1px"
                android:textColor="#3DDC84"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNudgeRight1"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_dock_btn"
                android:text="1px ▶"
                android:textColor="#3DDC84"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- [10px 이동 화살표 버튼] -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnNudgeLeft10"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_dock_btn"
                android:text="◀ 10"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNudgeUp10"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_dock_btn"
                android:text="▲ 10"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNudgeDown10"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_dock_btn"
                android:text="▼ 10"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNudgeRight10"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_dock_btn"
                android:text="10 ▶"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 핵심 액션 버튼 (테스트 클릭 / 저장 / 닫기) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- 테스트 클릭 버튼 -->
            <TextView
                android:id="@+id/btnTestClick"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_floating_handle"
                android:text="🎯 지금 테스트 클릭"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- 저장 버튼 -->
            <TextView
                android:id="@+id/btnSaveCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_floating_handle"
                android:text="💾 이 위치 저장"
                android:textColor="#3DDC84"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- 닫기 버튼 -->
            <TextView
                android:id="@+id/btnClosePicker"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_dock_btn"
                android:text="✖ 닫기"
                android:textColor="#FF5252"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
