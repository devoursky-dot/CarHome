<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- 1. 상단 상태 표시줄 (가로 1줄 고정, 줄바꿈/깨짐 방지) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- RAM 사용량 -->
        <TextView
            android:id="@+id/tvMemory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAM: 0%"
            android:textColor="#DDDDDD"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:layout_marginEnd="16dp" />

        <!-- 배터리 잔량 & 충전 -->
        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BAT: 100%"
            android:textColor="#DDDDDD"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:layout_marginEnd="16dp" />

        <!-- 접근성 매크로 상태 (터치 시 설정 바로가기) -->
        <LinearLayout
            android:id="@+id/btnAccessibilityStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_dock_btn"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvAccessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 매크로 꺼짐"
                android:textColor="#FF5252"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <!-- GPS 상태 (줄바꿈 방지) -->
        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS: 준비"
            android:textColor="#3DDC84"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 2. 중앙 대시보드 영역 (날짜 -> 시계 -> GPS 속도계) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- [1] 날짜 및 요일 (시간 바로 윗줄 배치) -->
        <TextClock
            android:id="@+id/textClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="yyyy년 M월 d일 (E)"
            android:format24Hour="yyyy년 M월 d일 (E)"
            android:textColor="#B0B0B0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- [2] 대형 디지털 시계 (시간 + AM/PM) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="true"
            android:layout_marginBottom="16dp">

            <TextClock
                android:id="@+id/textClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="82sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/textClockAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="a"
                android:format24Hour=" "
                android:textColor="#3DDC84"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- [3] GPS 실시간 디지털 속도계 & 주행 방위 카드 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_dark"
            android:paddingStart="44dp"
            android:paddingEnd="44dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvGpsSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 km/h"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGpsHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ 🧭 정지 ]"
                android:textColor="#3DDC84"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 하단 2대 핵심 독(Dock) 버튼 ([📦 전체 앱] & [⚙️ 환경설정]) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:weightSum="2">

        <LinearLayout
            android:id="@+id/btnAllApps"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dock_btn"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦  전체 앱"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_dock_btn"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️  환경설정"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>