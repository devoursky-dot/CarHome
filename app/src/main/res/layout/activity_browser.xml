<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="#000000">

    <!-- 기본 브라우저 레이아웃 -->
    <LinearLayout
        android:id="@+id/browserRootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:keepScreenOn="true"
        android:background="#000000">

        <!-- 상단 2단 툴바 (배속과 해상도 2줄 균등 배치) -->
        <LinearLayout
            android:id="@+id/menuLayout"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:orientation="vertical"
            android:background="#121212"
            android:gravity="center">

            <!-- 첫 번째 줄 (Group 1): [💾 RAM 배지] & 배속 조절 (1X, 1.5X, 2X) -->
            <LinearLayout
                android:id="@+id/menuGroup1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- 실시간 RAM 상태 모니터링 배지 버튼 -->
                <TextView
                    android:id="@+id/btnRamStatus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_btn_inactive"
                    android:text="💾 RAM 확인중"
                    android:textColor="#3DDC84"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnSpeed1x"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_btn_inactive"
                    android:text="1X"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnSpeed1_5x"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_btn_inactive"
                    android:text="1.5X"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnSpeed2x"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_btn_inactive"
                    android:text="2X"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 두 번째 줄 (Group 3): 해상도 조절 (144P, 240P, 360P, 480P, 720P, 1080P) -->
            <LinearLayout
                android:id="@+id/menuGroup3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnRes144"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_btn_inactive"
                    android:text="144P"
                    android:textColor="#3DDC84"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnRes240"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_btn_inactive"
                    android:text="240P"
                    android:textColor="#3DDC84"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnRes360"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_btn_inactive"
                    android:text="360P"
                    android:textColor="#3DDC84"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnRes480"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_btn_inactive"
                    android:text="480P"
                    android:textColor="#3DDC84"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnRes720"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_btn_inactive"
                    android:text="720P"
                    android:textColor="#3DDC84"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnRes1080"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_btn_inactive"
                    android:text="1080P"
                    android:textColor="#3DDC84"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 웹뷰 영역 -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:keepScreenOn="true"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- HTML5 비디오 전체화면 전용 풀스크린 컨테이너 (화면 꺼짐 방지) -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>