<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="32dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CarHome 환경설정"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />

        <!-- 설정 창 닫기 버튼 -->
        <ImageView
            android:id="@+id/btnCloseSettings"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_round_btn"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="centerInside" />
    </RelativeLayout>

    <!-- 설정 항목 리스트 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 숨김 버튼 높이 조절 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="숨김 버튼 높이 (Y축)"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/tvFloatingY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#3DDC84"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekFloatingY" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="32dp" android:max="500" />

            <!-- 팝업 메뉴 위치 조절 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="팝업 메뉴 위치 (Y축)"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/tvPopupY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#3DDC84"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekPopupY" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="32dp" android:max="800" />

            <!-- 2. 메뉴 자동 닫힘 시간 조절 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="메뉴 자동 닫힘 대기 시간"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/tvAutoClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#3DDC84"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekAutoClose" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="32dp" android:max="30" />

            <!-- 3. 티맵 터치 X 좌표 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="티맵 매크로 [X 좌표]" android:textColor="#FFFFFF" android:textSize="20sp" />
                <TextView android:id="@+id/tvTmapX" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3DDC84" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekTmapX" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="32dp" android:max="2500" />

            <!-- 4. 티맵 터치 Y 좌표 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="티맵 매크로 [Y 좌표]" android:textColor="#FFFFFF" android:textSize="20sp" />
                <TextView android:id="@+id/tvTmapY" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3DDC84" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekTmapY" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="32dp" android:max="2500" />

            <!-- 5. 숨김버튼 시계 크기 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="숨김버튼 시계 크기" android:textColor="#FFFFFF" android:textSize="20sp" />
                <TextView android:id="@+id/tvHandleClockSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3DDC84" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekHandleClockSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="32dp" android:max="40" android:min="10" />

            <!-- 6. 팝업메뉴 시계 크기 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="팝업메뉴 시계 크기" android:textColor="#FFFFFF" android:textSize="20sp" />
                <TextView android:id="@+id/tvPopupClockSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3DDC84" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekPopupClockSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="32dp" android:max="100" android:min="20" />

            <!-- 7. 팝업메뉴 아이콘 크기 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="팝업메뉴 아이콘 크기" android:textColor="#FFFFFF" android:textSize="20sp" />
                <TextView android:id="@+id/tvPopupIconSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3DDC84" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekPopupIconSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="32dp" android:max="150" android:min="50" />

            <!-- 안내 문구 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="* 설정값은 조절 즉시 저장 및 실시간 적용됩니다."
                android:textColor="#888888"
                android:gravity="center"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>